# Local development defaults only. Replace all credentials outside local development.
NODE_ENV=development
LOG_LEVEL=info

# JWT
JWT_SECRET=local-development-secret-change-me
JWT_ISSUER=microservices-backend
JWT_AUDIENCE=microservices-api
JWT_TTL_SECONDS=900
JWT_CLOCK_TOLERANCE_SECONDS=5
DEMO_USERNAME=demo
DEMO_PASSWORD=demo-password

# Order Service
ORDER_SERVICE_HOST=0.0.0.0
ORDER_SERVICE_PORT=3000
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60

# Notification Service
NOTIFICATION_SERVICE_HOST=0.0.0.0
NOTIFICATION_SERVICE_PORT=3001
NOTIFICATION_SERVICE_URL=http://localhost:3001
DEMO_FAILURE_MODE=off

# Infrastructure
DATABASE_URL=postgresql://app:app@localhost:5432/orders
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://app:app@localhost:5672

# OpenTelemetry / Jaeger
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=always_on
